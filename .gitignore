node_modules/
.cache/
.env
.env.*
!.env.example
dist/
# Fleet knowledge is committed (day rollups, decisions, saved suggestions); only temp files aren't.
.fleet/**/*.tmp
# The daily build (npm run build:data): end users' prompts and ids — never committed.
.data/
# Yarn state for the serverless package (its lockfile is committed)
serverless/.yarn/
serverless/target/
