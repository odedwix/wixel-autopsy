# Copy to .env (gitignored) and fill in what you have. Everything is optional except being on
# the Wix network (office or VPN) — the run list, details, insights and review videos need nothing else.

# Port for the local app (http://localhost:5178)
# PORT=5178

# Local cache size cap in GB (least-recently-used entries are evicted past it)
# CACHE_MAX_GB=3

# Temporal Cloud API key for the prod namespace (prod-wixel.imhi2) — enables "Open graph run".
# This is a production secret: get your own from the Wixel/Genix team; never commit or share it.
# TEMPORAL_API_KEY=
# …or point at a file containing a line TEMPORAL_KEY=… (default: ~/dev/wixel-video-server/packages/ai-video-genix-grapher/.env)
# TEMPORAL_KEY_FILE=

# A wixel-video-client checkout, for the exact live player (npm run build:player). Default: ~/dev/wixel-video-client
# WIXEL_VIDEO_CLIENT=

# Google Chrome for PDF reports and Exact composition downloads (found automatically on macOS)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---- Fleet (every major skill at once: /fleet.html) ----
# Where the daily rollups live (default .fleet/ in this folder). Point several people at one shared
# folder so one machine builds the days (npm run fleet:nightly) and the others only read them.
# FLEET_DIR=
# This install only reads rollups another machine builds — never queries Trino for them.
# FLEET_READONLY=1
# A wix-private/wixel-agent-codex checkout, for fix briefs that point at the exact skill / resource /
# RPC schema files (read with git only, from its latest fetched commit). Default: ~/dev/wixel-agent-codex
# CODEX_DIR=

# ---- Shared copy (built once a day, read by everyone) ----
# Serve only the daily build (npm run build:data) and never query Trino.
# AUTOPSY_SNAPSHOT=1
# Where the daily build lives (default .data/ in this folder; never commit it: it holds end users' prompts)
# DATA_DIR=
# Listen address (default 127.0.0.1). Anything else must sit behind the back office's staff sign-in.
# HOST=0.0.0.0
# Disk cache folder (default .cache/ in this folder)
# CACHE_DIR=
# Parsed daily-build files kept in memory, in MB (default 400)
# SNAPSHOT_MEMORY_MB=400
